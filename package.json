{
  "name": "atelier-3d-portal",
  "version": "0.2.0",
  "private": true,
  "description": "Atelier 3D Portal: plataforma de gestão empresarial para impressão 3D FDM",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:arch": "vitest run --project arch",
    "backup:verify": "bash scripts/backup-verify.sh"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.0"
}

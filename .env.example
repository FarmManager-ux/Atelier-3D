# Copiar para .env.local (nunca fazer commit de valores reais).
# Valores em: Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEGREDO (só servidor, nunca NEXT_PUBLIC_): usado para concluir/verificar uploads.
# Supabase → Project Settings → API → service_role. Nunca colocar no browser nem no repositório.
SUPABASE_SERVICE_ROLE_KEY=

# Só para testes da base de dados (PostgreSQL local/CI), nunca para produção.

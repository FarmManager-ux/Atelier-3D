# Copiar para .env.local (NUNCA fazer commit de valores reais).
# Valores em: Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEGREDO (só servidor, nunca com prefixo NEXT_PUBLIC_): chave service_role.
# A arquitetura só permite usá-la em src/modules/*/server/, route handlers e server actions.
SUPABASE_SERVICE_ROLE_KEY=

# Testes de base de dados (PostgreSQL local/CI com superutilizador). Nunca apontar a produção.
# TEST_DATABASE_URL=postgres://utilizador:palavra-passe@127.0.0.1:5432/postgres

# Backups (ver docs/BACKUPS.md). Normalmente só como segredos do GitHub Actions.
# SUPABASE_DB_URL=
# BACKUP_PASSPHRASE=
